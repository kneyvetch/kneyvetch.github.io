{
  "name": "kney-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Reconstructed Hexo source for Kney's GitHub Pages blog",
  "scripts": {
    "build": "node tools/prepare-build.js && hexo clean && hexo generate && node tools/finish-build.js && node tools/protect-essays.js",
    "server": "node tools/prepare-build.js && hexo server"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "hexo": "5.4.2",
    "hexo-generator-archive": "1.0.0",
    "hexo-generator-index": "2.0.0",
    "hexo-generator-tag": "1.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "4.1.0",
    "hexo-renderer-stylus": "2.1.0",
    "hexo-server": "2.0.0",
    "hexo-theme-next": "7.8.0",
    "hexo-cli": "4.3.2",
    "hexo-generator-category": "1.0.0"
  },
  "hexo": {
    "version": "5.4.2"
  }
}
